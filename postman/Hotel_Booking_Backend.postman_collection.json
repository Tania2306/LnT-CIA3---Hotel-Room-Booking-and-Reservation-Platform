          "name": "Register Guest (Happy Path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('guestToken', data.token);",
                  "pm.collectionVariables.set('guestId', data.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Guest\",\n  \"email\": \"guest1@example.com\",\n  \"password\": \"Guest@123\"\n}"
